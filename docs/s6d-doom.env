# Doom userspace. The module pin is docs/s6d-desktop.env, not fdf30c77.
# The engine prints zone size with %x: 600000 is 6 MiB.
# couldn't open demo1.lmp is the external-file probe. The wad lump is used.
# doom1.wad is shareware v1.9, 4196020 bytes, not shipped in this tree.
# SHA-256 matches the published v1.9 file (SHA-1 5b2e249b9c5133ec987b3ea77596381dc0d6bc1d).
# Replace UNPINNED after the i486 static build. The script does not insmod until then.
WD24X_DOOM_BIN=/tmp/wd24x-doom
WD24X_DOOM_SHA=UNPINNED
WD24X_WAD=/tmp/doom1.wad
WD24X_WAD_SHA=1d7d43be501e67d927e415e0b8f3e29c3bf33075e859721816f652a526cac771
WD24X_WAD_SIZE=4196020
