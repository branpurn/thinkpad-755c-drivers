# Proposed only. Not the boot config. Do not merge this into the
# running 6.18.57-tc755x image until a separate kernel build is asked
# for. See docs/s6d-kernel-speed.txt.
#
# Doom's renderer is userspace. These lines affect kernel paths
# (ioctl, tty, allocator, tick), not the column loop.

# CONFIG_CC_OPTIMIZE_FOR_SIZE is not set
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y

# CONFIG_FRAME_POINTER is not set

# CONFIG_SLUB_DEBUG is not set

# CONFIG_PERF_EVENTS is not set

# Leave these as they are. Listed so a later build does not "fix"
# them the other way:
# CONFIG_PREEMPT_NONE=y
# CONFIG_HZ_250=y
# CONFIG_HZ_PERIODIC=y
# CONFIG_HIGH_RES_TIMERS is not set
# CONFIG_SMP is not set
# CONFIG_M486=y
