# tc755 add-on: loadable module support for the tc32 core kernel.
# Merged AFTER tinycore-32-ram's base/hdd/tce fragments. This is the only
# change the core kernel needs; every driver below is built =m and shipped
# as a .tcz, so the floppy only pays for the module loader itself.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
# CONFIG_MODVERSIONS is not set
# CONFIG_MODULE_SIG is not set
# CONFIG_MODULE_COMPRESS is not set
# CONFIG_MODULE_FORCE_LOAD is not set
