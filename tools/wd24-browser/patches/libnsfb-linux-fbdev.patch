@@ -17,6 +17,7 @@
 #include "nsfb.h"
 #include "surface.h"
 #include "plot.h"
+#include "palette.h"
 
 #define UNUSED(x) ((x) = (x))
 
@@ -33,6 +34,18 @@ static int ram_defaults(nsfb_t *nsfb)
 }
 
 
+/* 8bpp plotters write index 0 when palette is NULL. */
+static void ram_ensure_palette(nsfb_t *nsfb)
+{
+    if (nsfb->format != NSFB_FMT_I8 || nsfb->width <= 0)
+        return;
+    if (nsfb->palette != NULL)
+        return;
+    if (nsfb_palette_new(&nsfb->palette, nsfb->width) != true)
+        return;
+    nsfb_palette_generate_nsfb_8bpp(nsfb->palette);
+}
+
 static int ram_initialise(nsfb_t *nsfb)
 {
     size_t size;
@@ -46,6 +59,7 @@ static int ram_initialise(nsfb_t *nsfb)
 
     nsfb->ptr = fbptr;
     nsfb->linelen = (nsfb->width * nsfb->bpp) / 8;
+    ram_ensure_palette(nsfb);
 
     return 0;
 }
@@ -99,6 +113,7 @@ ram_set_geometry(nsfb_t *nsfb, int width, int height, enum nsfb_format_e format)
     }
 
     nsfb->linelen = (nsfb->width * nsfb->bpp) / 8;
+    ram_ensure_palette(nsfb);
 
     return 0;
 }
