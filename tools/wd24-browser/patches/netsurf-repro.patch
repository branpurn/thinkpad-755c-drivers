diff --git a/tools/git-testament.pl b/tools/git-testament.pl
index aee8ca1..37df35f 100644
--- a/tools/git-testament.pl
+++ b/tools/git-testament.pl
@@ -18,6 +18,10 @@ $ENV{LC_ALL} = 'C';
 my $root = shift @ARGV;
 my $targetfile = shift @ARGV;
 
+if (defined $ENV{WD24X_BUILD_ROOT} && $ENV{WD24X_BUILD_ROOT} ne "") {
+   $root = $ENV{WD24X_BUILD_ROOT};
+}
+
 my %gitinfo; # The Git information
 
 $root .= "/" unless ($root =~ m@/$@);
@@ -109,9 +113,19 @@ my %userinfo; # The information about the current user
    $userinfo{GECOS} = $gecos;
 }
 
+if (defined $ENV{WD24X_BUILD_USER} && $ENV{WD24X_BUILD_USER} ne "") {
+   $userinfo{USERNAME} = $ENV{WD24X_BUILD_USER};
+   $userinfo{GECOS} = $ENV{WD24X_BUILD_USER};
+}
+
 # The current date, in AmigaOS version friendly format (dd.mm.yyyy)
 
-my ($sec,$min,$hour,$mday,$mon,$year,$wday,$yday,$isdst) = localtime();
+my ($sec,$min,$hour,$mday,$mon,$year,$wday,$yday,$isdst);
+if (defined $ENV{SOURCE_DATE_EPOCH} && $ENV{SOURCE_DATE_EPOCH} =~ /^[0-9]+$/) {
+   ($sec,$min,$hour,$mday,$mon,$year,$wday,$yday,$isdst) = gmtime($ENV{SOURCE_DATE_EPOCH});
+} else {
+   ($sec,$min,$hour,$mday,$mon,$year,$wday,$yday,$isdst) = localtime();
+}
 my $compiledate = sprintf("%02d.%02d.%d",$mday,$mon+1,$year+1900);
 chomp $compiledate;
 
