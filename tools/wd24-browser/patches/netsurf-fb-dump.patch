+++ b/frontends/framebuffer/framebuffer.c
@@ -573,6 +573,34 @@ static bool framebuffer_format_from_bpp(int bpp, enum nsfb_format_e *fmt)
 
 
 
+void
+framebuffer_dump(const char *path)
+{
+	uint8_t *ptr;
+	int stride;
+	int width;
+	int height;
+	FILE *fp;
+	size_t nbytes;
+
+	if (nsfb == NULL || path == NULL || path[0] == '\0')
+		return;
+	nsfb_get_buffer(nsfb, &ptr, &stride);
+	nsfb_get_geometry(nsfb, &width, &height, NULL);
+	if (ptr == NULL || stride <= 0 || height <= 0)
+		return;
+	fp = fopen(path, "wb");
+	if (fp == NULL)
+		return;
+	nbytes = (size_t)stride * (size_t)height;
+	if (fwrite(ptr, 1, nbytes, fp) != nbytes)
+		fprintf(stderr, "WD24X-BROWSER dump short\n");
+	else
+		fprintf(stderr, "WD24X-BROWSER dump %s %d %d %d\n",
+			path, width, height, stride);
+	fclose(fp);
+}
+
